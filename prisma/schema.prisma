// twentyfive.lk database schema.
// Each feature adds its own models in its own migration (see prisma/migrations).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Province {
  WESTERN
  CENTRAL
  SOUTHERN
  NORTHERN
  EASTERN
  NORTH_WESTERN
  NORTH_CENTRAL
  UVA
  SABARAGAMUWA
}

/// One of Sri Lanka's 25 districts. Reference data, seeded from prisma/seed-data/districts.ts.
model District {
  /// URL slug, e.g. "kandy", "nuwara-eliya".
  id          String   @id
  name        String   @unique
  nameSi      String   @map("name_si")
  nameTa      String   @map("name_ta")
  province    Province
  tagline     String
  description String
  famousFor   String[] @map("famous_for")
  /// Two hex colours used for the district's placeholder gradient.
  colorFrom   String   @map("color_from")
  colorTo     String   @map("color_to")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  residents User[]
  followers DistrictFollow[]
  posts     Post[]

  @@index([province])
  @@map("districts")
}

enum OAuthProvider {
  GOOGLE
  FACEBOOK
  X
}

model User {
  id          String    @id @default(uuid()) @db.Uuid
  /// Lowercase handle shown as @username. 3–20 chars: a–z, 0–9, _.
  username    String    @unique
  displayName String    @map("display_name")
  bio         String    @default("")
  /// From the sign-in provider when it shares one. Never shown publicly.
  email       String?
  avatarUrl   String?   @map("avatar_url")
  hometownId  String?   @map("hometown_id")
  hometown    District? @relation(fields: [hometownId], references: [id])
  isPrivate   Boolean   @default(false) @map("is_private")
  /// Null until the user finishes onboarding.
  onboardedAt DateTime? @map("onboarded_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  accounts        OAuthAccount[]
  sessions        Session[]
  districtFollows DistrictFollow[]
  following       Follow[]         @relation("follower")
  followers       Follow[]         @relation("followee")
  media           Media[]
  posts           Post[]
  comments        Comment[]
  postLikes       PostLike[]
  reposts         Repost[]
  notifications   Notification[]   @relation("recipient")
  notified        Notification[]   @relation("actor")
  blocking        Block[]          @relation("blocker")
  blockedBy       Block[]          @relation("blocked")
  reports         Report[]

  @@index([hometownId])
  @@map("users")
}

/// A provider login linked to a user (a user can link Google and Facebook, for example).
model OAuthAccount {
  id                String        @id @default(uuid()) @db.Uuid
  provider          OAuthProvider
  providerAccountId String        @map("provider_account_id")
  userId            String        @map("user_id") @db.Uuid
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime      @default(now()) @map("created_at")

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

/// A refresh-token session. Tokens rotate on every refresh; only their SHA-256 hash is stored.
/// All rotations of one sign-in share a familyId, so reuse of an old token revokes the whole family.
model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

/// Following a district puts its posts in your feed and counts towards its followers.
model DistrictFollow {
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  districtId String   @map("district_id")
  district   District @relation(fields: [districtId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@id([userId, districtId])
  @@index([districtId])
  @@map("district_follows")
}

enum FollowStatus {
  /// Waiting for a private account to approve.
  PENDING
  ACCEPTED
}

/// followerId follows followeeId. Following a private account starts PENDING.
model Follow {
  followerId String       @map("follower_id") @db.Uuid
  follower   User         @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followeeId String       @map("followee_id") @db.Uuid
  followee   User         @relation("followee", fields: [followeeId], references: [id], onDelete: Cascade)
  status     FollowStatus
  createdAt  DateTime     @default(now()) @map("created_at")
  acceptedAt DateTime?    @map("accepted_at")

  @@id([followerId, followeeId])
  @@index([followeeId, status])
  @@map("follows")
}

enum MediaPurpose {
  POST_PHOTO
  AVATAR
}

enum MediaStatus {
  /// Upload URL issued; the browser may not have uploaded yet.
  PENDING
  /// Uploaded and verified (exists, within size limit, really an image).
  READY
}

/// A photo uploaded straight to object storage (S3) by the browser.
model Media {
  id          String       @id @default(uuid()) @db.Uuid
  ownerId     String       @map("owner_id") @db.Uuid
  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  purpose     MediaPurpose
  status      MediaStatus  @default(PENDING)
  /// Object key in the bucket, e.g. post_photo/<owner>/<id>.jpg
  key         String       @unique
  contentType String       @map("content_type")
  sizeBytes   Int?         @map("size_bytes")
  createdAt   DateTime     @default(now()) @map("created_at")
  readyAt     DateTime?    @map("ready_at")
  postPhoto   PostPhoto?

  @@index([ownerId, status])
  @@map("media")
}

enum PostAudience {
  EVERYONE
  /// Only the author's approved followers.
  FOLLOWERS
}

model Post {
  id         String       @id @default(uuid()) @db.Uuid
  authorId   String       @map("author_id") @db.Uuid
  author     User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  /// The district the post is about (shown on that district's page). Not the author's location.
  districtId String       @map("district_id")
  district   District     @relation(fields: [districtId], references: [id])
  body       String       @default("")
  audience   PostAudience @default(EVERYONE)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  photos        PostPhoto[]
  comments      Comment[]
  likes         PostLike[]
  reposts       Repost[]
  notifications Notification[]

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([authorId, createdAt(sort: Desc)])
  @@index([districtId, createdAt(sort: Desc)])
  @@map("posts")
}

model PostPhoto {
  id       String @id @default(uuid()) @db.Uuid
  postId   String @map("post_id") @db.Uuid
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  /// Each upload can be used by one post only.
  mediaId  String @unique @map("media_id") @db.Uuid
  media    Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  url      String
  position Int

  @@index([postId, position])
  @@map("post_photos")
}

model Comment {
  id            String         @id @default(uuid()) @db.Uuid
  postId        String         @map("post_id") @db.Uuid
  post          Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId      String         @map("author_id") @db.Uuid
  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body          String
  createdAt     DateTime       @default(now()) @map("created_at")
  notifications Notification[]

  @@index([postId, createdAt, id])
  @@map("comments")
}

/// One like per user per post.
model PostLike {
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String   @map("post_id") @db.Uuid
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, postId])
  @@index([postId])
  @@map("post_likes")
}

/// Sharing a public post with your followers. One per user per post.
model Repost {
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String   @map("post_id") @db.Uuid
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, postId])
  @@index([postId])
  @@map("reposts")
}

enum NotificationType {
  FOLLOW
  FOLLOW_REQUEST
  FOLLOW_ACCEPTED
  COMMENT
  REPOST
}

/// Something that happened to a user, caused by another user (the actor).
model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  recipientId String           @map("recipient_id") @db.Uuid
  recipient   User             @relation("recipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actorId     String           @map("actor_id") @db.Uuid
  actor       User             @relation("actor", fields: [actorId], references: [id], onDelete: Cascade)
  type        NotificationType
  postId      String?          @map("post_id") @db.Uuid
  post        Post?            @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId   String?          @map("comment_id") @db.Uuid
  comment     Comment?         @relation(fields: [commentId], references: [id], onDelete: Cascade)
  /// Preview text, e.g. the start of a comment.
  excerpt     String?
  readAt      DateTime?        @map("read_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  @@index([recipientId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([recipientId, readAt])
  @@map("notifications")
}

/// The blocker and the blocked can't see or interact with each other's posts, or follow each other.
model Block {
  blockerId String   @map("blocker_id") @db.Uuid
  blocker   User     @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String   @map("blocked_id") @db.Uuid
  blocked   User     @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

enum ReportTarget {
  POST
  COMMENT
  USER
}

enum ReportReason {
  SPAM
  HARASSMENT
  HATE
  VIOLENCE
  NUDITY
  MISINFORMATION
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

/// A user flagging a post, comment or profile for review. Targets aren't foreign keys,
/// so reports outlive deleted content for moderators.
model Report {
  id         String       @id @default(uuid()) @db.Uuid
  reporterId String       @map("reporter_id") @db.Uuid
  reporter   User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  targetType ReportTarget @map("target_type")
  targetId   String       @map("target_id") @db.Uuid
  reason     ReportReason
  details    String       @default("")
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now()) @map("created_at")

  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@map("reports")
}
