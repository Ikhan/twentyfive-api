# Copy to .env and adjust. Every variable is validated at startup (src/config/env.schema.ts).

NODE_ENV=development
PORT=3000

# Browser origins allowed to call the API (comma-separated). The web app runs on Vite's port.
CORS_ORIGINS=http://localhost:5173

# Rate limiting: requests per client per window.
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120

# PostgreSQL (docker compose runs it on 5433). Tests use the separate twentyfive_test database.
DATABASE_URL=postgresql://twentyfive:twentyfive@localhost:5433/twentyfive

# Web app and public API URLs (OAuth redirects).
WEB_APP_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3000

# Auth. Generate the secret with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# COOKIE_DOMAIN=.twentyfive.lk

# OAuth apps (a provider is enabled only when both values are set).
# Redirect URI to register with each provider: ${API_PUBLIC_URL}/api/v1/auth/<google|facebook>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Photo storage. Locally this is MinIO from docker compose (create the bucket once: see README).
S3_BUCKET=twentyfive-media
S3_REGION=ap-south-1
S3_ENDPOINT=http://localhost:9002
S3_ACCESS_KEY_ID=twentyfive
S3_SECRET_ACCESS_KEY=twentyfive-secret
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9002/twentyfive-media
